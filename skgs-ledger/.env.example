# Copy this file to .env and fill in your real values.
# .env is already git-ignored so your password never gets committed.

# Get this from MongoDB Atlas: Database > Connect > Drivers
# Replace <username>, <password> and the cluster host with your own.
# If MONGODB_URI is not provided or is invalid, the server starts with a local JSON fallback at data/ledger.json.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skgs_ledger?retryWrites=true&w=majority

# Port the server listens on (most hosts set this automatically)
PORT=5000
